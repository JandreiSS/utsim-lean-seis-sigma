        [0] {""}
        [1] {" "}1 segno di alterazione.
       *[other] {" "}{ $severe } segni di alterazione.
    }{ $other ->
        [0] {""}
        [1] {" "}1 avviso.
       *[other] {" "}{ $other } avvisi.
    }
